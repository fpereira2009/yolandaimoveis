-            if (imgRatio > boxRatio) {
-                drawW = h * imgRatio;
-                offsetX = x - (drawW - w) / 2;
-            } else {
-                drawH = w / imgRatio;
-                offsetY = y - (drawH - h) / 2;
-            }
-            ctx.drawImage(img, offsetX, offsetY, drawW, drawH);
-        }
